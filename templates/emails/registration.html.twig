<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Registration Complete</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; background-color:#f5f5f7; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f5f7; padding:40px 0;">
    <tr>
        <td align="center">

            <!-- Card Container -->
            <table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px; background:#ffffff; border-radius:18px; box-shadow:0 10px 30px rgba(0,0,0,0.05); padding:40px;">
                
                <!-- Logo / Header -->
                <tr>
                    <td align="center" style="padding-bottom:30px;">
                        <div style="font-size:28px; font-weight:600; color:#1d1d1f; letter-spacing:-0.5px;">
                            Welcome 🎉
                        </div>
                    </td>
                </tr>

                <!-- Greeting -->
                <tr>
                    <td style="font-size:20px; font-weight:500; color:#1d1d1f; padding-bottom:15px;">
                        Hello {{ name }},
                    </td>
                </tr>

                <!-- Message -->
                <tr>
                    <td style="font-size:16px; color:#6e6e73; line-height:1.6; padding-bottom:25px;">
                        Your registration has been successfully completed.  
                        We're excited to have you onboard.
                    </td>
                </tr>

                <!-- Info Box -->
                <tr>
                    <td style="background:#f5f5f7; padding:18px; border-radius:12px; font-size:14px; color:#1d1d1f;">
                        <strong>Email:</strong> {{ email }}
                    </td>
                </tr>

                <!-- Divider -->
                <tr>
                    <td style="padding:30px 0;">
                        <hr style="border:none; border-top:1px solid #e5e5e7;">
                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="font-size:14px; color:#86868b; text-align:center;">
                        If you did not create this account, please ignore this email.
                        <br><br>
                        <strong style="color:#1d1d1f;">Thank you</strong>
                    </td>
                </tr>

            </table>

            <!-- Bottom spacing -->
            <div style="height:40px;"></div>

        </td>
    </tr>
</table>

</body>
</html>